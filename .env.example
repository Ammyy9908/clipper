PORT=8080
DATABASE_URL=postgres://clipper:clipper@localhost:5432/clipper?sslmode=disable
REDIS_ADDR=localhost:6379
PLAYLIST_MAX_ITEMS=50
S3_BUCKET=clipper-dev
S3_ENDPOINT=http://localhost:9000
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
MAX_UPLOAD_MB=512
PRESIGN_TTL_MIN=15
OUTPUT_TTL_HOURS=24
WORKER_CONCURRENCY=2
JOB_TIMEOUT_MIN=20
WORK_DIR=/tmp/clipper

# Remote fetching
YTDLP_BIN=yt-dlp
# Comma-separated. Datacenter egress gets blocked quickly on YouTube;
# expect to need residential proxies here sooner than you think.
PROXY_POOL=
COOKIES_FILE=

# Google sign-in and daily download limits. Set GOOGLE_CLIENT_ID (a "Web application"
# OAuth client id) and SESSION_SECRET (32+ random characters) to enable sign-in.
GOOGLE_CLIENT_ID=
SESSION_SECRET=
SESSION_TTL_HOURS=168
# Daily download limits. 0 = unlimited. Anonymous callers are limited per device and per IP.
ANON_DAILY_LIMIT=3
ANON_IP_DAILY_LIMIT=9
USER_DAILY_LIMIT=20
QUOTA_TZ=UTC
# Proxies whose X-Forwarded-For is trusted (CIDRs or IPs), e.g. your web server.
TRUSTED_PROXY_CIDRS=

# Razorpay Payments & Credits Model
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
DAILY_FREE_CREDITS=10
CREDITS_ENABLED=true

# Limits on what one download may cost. 0 turns a cap off.
MAX_DOWNLOAD_MB=4096
MAX_DURATION_MINUTES=360
# yt-dlp lookups allowed at once; more callers wait, then get "busy".
RESOLVE_CONCURRENCY=8

# Requests per minute from one IP, by kind. 0 turns a limit off. These count
# per caller IP, so TRUSTED_PROXY_CIDRS must be right or everyone shares one.
RATE_LIMIT_RESOLVE_PER_MIN=20
RATE_LIMIT_WRITE_PER_MIN=20
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_READ_PER_MIN=300

# Website origins allowed to call the API from a browser (comma-separated,
# exact match, no trailing slash). Needed when the site calls the API directly.
CORS_ALLOWED_ORIGINS=https://clipplay.video,https://www.clipplay.video
