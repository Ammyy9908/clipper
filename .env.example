PORT=8080
DATABASE_URL=postgres://clipper:clipper@localhost:5432/clipper?sslmode=disable
REDIS_ADDR=localhost:6379
S3_BUCKET=clipper-dev
S3_ENDPOINT=http://localhost:9000
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
MAX_UPLOAD_MB=512
PRESIGN_TTL_MIN=15
OUTPUT_TTL_HOURS=24
WORKER_CONCURRENCY=2
JOB_TIMEOUT_MIN=20
WORK_DIR=/tmp/clipper

# Remote fetching
YTDLP_BIN=yt-dlp
# Comma-separated. Datacenter egress gets blocked quickly on YouTube;
# expect to need residential proxies here sooner than you think.
PROXY_POOL=
COOKIES_FILE=
